# Mono 嵌入宿主构建产物（Engine.dll + Roslyn 依赖 + 编译好的宿主，由 CI 生成）
src/mono_host/out/
*.dll
# 例外：BepInEx/core 托管 dll 是 vendored 进来的（与星云包锁版本，构建期嵌进 dylib，非构建产物）
!src/mono_host/bepinex-core/
!src/mono_host/bepinex-core/*.dll
# 例外：预生成 iOS 版 interop 桥接 dll（PC 针对 17.3.1o 预生成、随包发布，非构建产物；
#       设备端 R59 不再现场生成，必须随仓库固定版本，否则 CI/clone 打包时无 interop）
!src/mono_host/prebuilt-interop/
!src/mono_host/prebuilt-interop/*.dll
!src/mono_host/prebuilt-interop/*.db
!src/mono_host/prebuilt-interop/*.txt
# 例外：Unity 2022.3.44 托管基础库（构建期嵌进 dylib 当 Cecil 参考，vendored，非构建产物）
!src/mono_host/unity-libs/
!src/mono_host/unity-libs/*.dll
# 例外：[R87] 预生成的 .NET 8 System.Runtime facade 补丁版（补了 Marshal 转发；
#       随仓库固定，构建期直接替换 BCL 原件，避免 CI 依赖 dotnet）
!src/mono_host/facade-patch/
!src/mono_host/facade-patch/*.dll
# 例外：[R60] 预编译的服务器列表滑动补丁（BepInEx IL2CPP 插件，随包发布）
!src/plugins/ServerScroll/
!src/plugins/ServerScroll/*.dll
*.zip
*.dat
metadata/

# [R83] marshal 补丁的二进制原件备份（本地回滚用，不入库；真件 *.dll 已打补丁入库）
*.orig

# dotnet 工具编译产物（tools/patch_* 下的 bin/ obj/，R78 起忽略；源码与 csproj 入库）
tools/*/bin/
tools/*/obj/

# 已废弃的老 Mono 方案占位目录（按设备从 ipa 提取；含其 README，见目录内说明，不入库）
src/mono_host_mono/
